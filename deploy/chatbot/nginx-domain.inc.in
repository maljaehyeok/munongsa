# Candidate fragment for the existing canonical HTTPS server, not a complete config.
# Replace @BRIDGE_GATEWAY@ with the verified private Docker host gateway.
location = /api/chat {
    if ($request_method != POST) { return 405; }
    if ($http_origin != "https://munongsa.duckdns.org") { return 403; }
    if ($args != "") { return 400; }
    client_max_body_size 8k;
    client_body_timeout 5s;
    limit_req zone=munongsa_chat_rate burst=3 nodelay;
    limit_req_status 429;
    limit_conn munongsa_chat_conn 2;
    limit_conn_status 429;
    proxy_pass http://@BRIDGE_GATEWAY@:8765;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host munongsa.duckdns.org;
    proxy_set_header Origin $http_origin;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 2s;
    proxy_send_timeout 5s;
    proxy_read_timeout 10s;
    proxy_next_upstream off;
    proxy_cache off;
    access_log off;
    add_header Cache-Control "no-store" always;
}
