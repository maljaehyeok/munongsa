# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
.venv-collector/
venv/
env/
ENV/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_ecdsa_sk
id_ed25519_sk

# Public-only PEM certificates/keys may be versioned after content review.
# Standard public-key/certificate extensions (.pub, .crt, .cer) are not ignored.
!cert.pem
!chain.pem
!fullchain.pem
!public-key.pem

# Local authentication directories (including credentials without extensions)
.ssh/
.aws/
.docker/
/secrets/
/credentials/

# Logs and temporary files
*.log
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# Local-only working materials, raw research, generated output and old design
/work/
/outputs/
/data/source/
/index-before-redesign.html

# Persistent collector state must never enter a source release.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
publication-rights.json
